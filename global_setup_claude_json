    data = {}

if "mcpServers" not in data:
    data["mcpServers"] = {}

data["mcpServers"]["pubmed"] = {
    "command": "npx",
    "args": [
        "-y",
        "@ncukondo/mcp-server-pubmed",
        "--email",
        "your_email@example.com"
    ]
}

with open(path, "w") as f:
    json.dump(data, f, indent=2)

'


